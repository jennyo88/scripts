
m3u8() {
    check_ffmpeg || return 1

    echo -e "${MENU_1_COLOR}"
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║               VIDEO/AUDIO TO MKV               ║ "
    echo " ║                MOVIES & TV SHOWS                ║ "
    echo " ║             1080P - SPANISH AUDIO              ║ "
    echo " ╚═════════════════════════════════════════════════╝ ${RESET}"

    # Get user input
    get_user_input || return 1

    # Create directory
    create_directory || return 1

    # Download and combine video and Spanish audio
    convert_m3u8_to_mkv || return 1

    # Display completion message
    display_completion_message

    show_menu_1
}

get_user_input() {
    prompt "Destination directory? (default: DONE): " destDir "DONE"

    prompt "1080p video URL: " videoURL
    prompt "Spanish audio URL: " spanishURL

    if [ -z "$videoURL" ] || [ -z "$spanishURL" ]; then
        echo "Both video and Spanish audio URLs are required."
        return 1
    fi

    echo ""
    echo " 1) Movie"
    echo " 2) TV Show"
    prompt "Media type? (default: 1): " mediaType "1"

    prompt "Movie/TV show name? (periods between words): " baseName

    if [ -z "$baseName" ]; then
        echo "A title is required."
        return 1
    fi

    case "$mediaType" in
        1)
            prompt "Movie release year?: " baseYear
            if ! [[ "$baseYear" =~ ^[0-9]{4}$ ]]; then
                echo "Invalid release year."
                return 1
            fi
            ;;
        2)
            prompt "Season number?: " seasonNumber
            prompt "Episode number?: " episodeNumber

            if ! [[ "$seasonNumber" =~ ^[0-9]+$ &&
                    "$episodeNumber" =~ ^[0-9]+$ ]]; then
                echo "Invalid season or episode."
                return 1
            fi
            ;;
        *)
            echo "Invalid media type."
            return 1
            ;;
    esac

    # No default scene/channel/source
    prompt "Scene/channel/source? (optional): " baseScene ""

    baseResolution="1080p"
    destExt="mkv"
}

create_directory() {
    local cleanName season episode sourceName

    cleanName="${baseName// /.}"
    cleanName="${cleanName//\//_}"
    cleanName="${cleanName//\\/_}"

    if [ "$mediaType" = "1" ]; then
        dirName="${cleanName//./ } (${baseYear})"
        outputBase="${cleanName}.${baseYear}.1080p.WEBRip"
    else
        season=$((10#$seasonNumber))
        episode=$((10#$episodeNumber))

        printf -v season "%02d" "$season"
        printf -v episode "%02d" "$episode"

        dirName="${cleanName//./ }/Season ${season}"
        outputBase="${cleanName}.S${season}E${episode}.1080p.WEBRip"
    fi

    if [ -n "$baseScene" ]; then
        sourceName="${baseScene// /_}"
        sourceName="${sourceName//\//_}"
        sourceName="${sourceName//\\/_}"
        outputBase="${outputBase}-${sourceName}"
    fi

    outputDir="./${destDir}/${dirName}"
    mkdir -p "$outputDir" || return 1

    mkvFile="${outputDir}/${outputBase}.${destExt}"
}

convert_m3u8_to_mkv() {
    echo ""
    echo "Downloading 1080p video and Spanish audio..."
    echo ""

    if ffmpeg \
        -hide_banner \
        -stats \
        -i "$videoURL" \
        -i "$spanishURL" \
        -map 0:v:0 \
        -map 1:a:0 \
        -c copy \
        -metadata:s:a:0 language=spa \
        -metadata:s:a:0 title="Spanish" \
        -disposition:a:0 default \
        -y "$mkvFile"; then

        echo "Video and Spanish audio merged successfully!"
        return 0
    else
        echo -e "${ERROR}Error merging video and audio.${RESET}"
        return 1
    fi
}

display_completion_message() {
    echo ""
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║             DOWNLOAD COMPLETED                 ║ "
    echo " ╚═════════════════════════════════════════════════╝ "

    echo "Video: 1080p source"
    echo "Audio: Spanish"
    echo "Container: MKV"
    echo "Output: $mkvFile"

    echo ""
    echo "Final stream information:"

    ffprobe \
        -v error \
        -show_entries \
        stream=index,codec_type,codec_name,width,height:stream_tags=language,title \
        -of compact \
        "$mkvFile"

    echo -e "\a"
}
