
m3u8() {
    check_ffmpeg || return 1

    # Check additional dependencies
    for tool in ffprobe python3; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            echo -e "${ERROR}Missing dependency: $tool${RESET}"
            return 1
        fi
    done

    echo -e "${MENU_1_COLOR}"
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║               M3U8 TO MKV SCRIPT               ║ "
    echo " ║              MOVIES AND TV SHOWS                ║ "
    echo " ║         1080P - ENGLISH/SPANISH AUDIO           ║ "
    echo " ╚═════════════════════════════════════════════════╝ ${RESET}"

    # Get user input
    get_user_input || return 1

    # Create output directory
    create_directory || return 1

    # Download directly to MKV
    convert_m3u8_to_mkv || return 1

    # Completion
    display_completion_message

    show_menu_1
}

get_user_input() {
    prompt "Destination directory? (default: DONE): " destDir "DONE"
    prompt "Source M3U8 web-address?: " srcAdd

    [[ -n "$srcAdd" ]] || {
        echo "A source URL is required."
        return 1
    }

    echo ""
    echo " 1) Movie"
    echo " 2) TV Show"
    prompt "Media type? (default: 1): " mediaType "1"

    prompt "Movie/TV show name? (periods between words): " baseName

    [[ -n "$baseName" ]] || {
        echo "A title is required."
        return 1
    }

    case "$mediaType" in
        1)
            prompt "Movie release year?: " baseYear

            [[ "$baseYear" =~ ^[0-9]{4}$ ]] || {
                echo "Invalid release year."
                return 1
            }
            ;;
        2)
            prompt "Season number?: " seasonNumber
            prompt "Episode number?: " episodeNumber

            [[ "$seasonNumber" =~ ^[0-9]+$ &&
               "$episodeNumber" =~ ^[0-9]+$ ]] || {
                echo "Invalid season/episode."
                return 1
            }
            ;;
        *)
            echo "Invalid media type."
            return 1
            ;;
    esac

    # No default source
    prompt "Scene/channel/source? (optional): " baseScene ""

    baseResolution="1080p"
    destExt="mkv"
}

create_directory() {
    local cleanName season episode

    cleanName="${baseName// /.}"
    cleanName="${cleanName//\//_}"
    cleanName="${cleanName//\\/_}"

    if [ "$mediaType" = "1" ]; then
        dirName="${cleanName//./ } (${baseYear})"
        outputBase="${cleanName}.${baseYear}.${baseResolution}.WEBRip"
    else
        season=$((10#$seasonNumber))
        episode=$((10#$episodeNumber))

        printf -v season "%02d" "$season"
        printf -v episode "%02d" "$episode"

        dirName="${cleanName//./ }/Season ${season}"
        outputBase="${cleanName}.S${season}E${episode}.${baseResolution}.WEBRip"
    fi

    if [ -n "$baseScene" ]; then
        local sourceName="${baseScene// /_}"
        sourceName="${sourceName//\//_}"
        sourceName="${sourceName//\\/_}"
        outputBase="${outputBase}-${sourceName}"
    fi

    outputDir="./${destDir}/${dirName}"
    mkdir -p "$outputDir" || return 1

    mkvFile="${outputDir}/${outputBase}.${destExt}"

    echo ""
    echo "Output directory: $outputDir"
    echo "Filename: $outputBase.$destExt"
}

convert_m3u8_to_mkv() {
    echo ""
    echo "Checking available streams..."

    local probeFile streamList
    local videoIndex=""
    local type index language
    local -a audioIndexes=()
    local -a audioLanguages=()
    local -a maps=()
    local -a metadataArgs=()

    probeFile=$(mktemp) || return 1

    if ! ffprobe \
        -v error \
        -show_streams \
        -of json \
        "$srcAdd" > "$probeFile"; then

        rm -f "$probeFile"
        echo -e "${ERROR}Error reading M3U8.${RESET}"
        return 1
    fi

    # Identify 1080p video and English/Spanish audio
    streamList=$(python3 - "$probeFile" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as f:
    streams = json.load(f).get("streams", [])

videos = [
    s for s in streams
    if s.get("codec_type") == "video"
    and s.get("width") == 1920
    and s.get("height") == 1080
]

if not videos:
    sys.exit("No 1080p video available.")

video = max(
    videos,
    key=lambda s: int(s.get("bit_rate") or 0)
)

print("VIDEO", video["index"], "-", sep="\t")

for audio in streams:
    if audio.get("codec_type") != "audio":
        continue

    lang = audio.get("tags", {}).get(
        "language", "und"
    ).lower().replace("_", "-").split("-")[0]

    if lang in ("eng", "en"):
        print("AUDIO", audio["index"], "eng", sep="\t")
    elif lang in ("spa", "es"):
        print("AUDIO", audio["index"], "spa", sep="\t")
PY
) || {
        rm -f "$probeFile"
        echo -e "${ERROR}Stream selection failed.${RESET}"
        return 1
    }

    rm -f "$probeFile"

    while IFS=$'\t' read -r type index language; do
        case "$type" in
            VIDEO)
                videoIndex="$index"
                ;;
            AUDIO)
                audioIndexes+=("$index")
                audioLanguages+=("$language")
                ;;
        esac
    done <<< "$streamList"

    if [ -z "$videoIndex" ]; then
        echo -e "${ERROR}1080p video not found.${RESET}"
        return 1
    fi

    if [ ${#audioIndexes[@]} -eq 0 ]; then
        echo -e "${ERROR}No English or Spanish audio detected.${RESET}"
        return 1
    fi

    echo ""
    echo "Video: 1920x1080"
    echo "Audio tracks: ${#audioIndexes[@]}"

    maps=(-map "0:${videoIndex}")

    local i
    for i in "${!audioIndexes[@]}"; do
        maps+=(-map "0:${audioIndexes[$i]}")
        metadataArgs+=(
            "-metadata:s:a:${i}"
            "language=${audioLanguages[$i]}"
        )
        echo " Audio $((i+1)): ${audioLanguages[$i]}"
    done

    echo ""
    echo "Downloading M3U8 directly to MKV..."
    echo ""

    if ffmpeg \
        -hide_banner \
        -stats \
        -fflags +genpts \
        -i "$srcAdd" \
        "${maps[@]}" \
        "${metadataArgs[@]}" \
        -c copy \
        -avoid_negative_ts make_zero \
        -y "$mkvFile"; then

        echo ""
        echo "M3U8 to MKV conversion complete!"
        return 0
    else
        echo -e "${ERROR}Error converting M3U8 to MKV.${RESET}"
        return 1
    fi
}

display_completion_message() {
    echo ""
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║            DOWNLOAD COMPLETED                 ║ "
    echo " ╚═════════════════════════════════════════════════╝ "

    echo "Resolution: 1080p"
    echo "Audio: English / Spanish"
    echo "Container: MKV"
    echo "Output: $mkvFile"

    echo ""
    echo "Final stream information:"

    ffprobe \
        -v error \
        -show_entries \
        stream=index,codec_type,codec_name,width,height:stream_tags=language \
        -of compact \
        "$mkvFile"

    echo -e "\a"
}
