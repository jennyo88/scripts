
m3u8() {
    check_ffmpeg || return 1

    echo -e "${MENU_1_COLOR}"
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║              VIDEO/AUDIO TO MKV                ║ "
    echo " ║               MOVIES & TV SHOWS                ║ "
    echo " ║          1080P - AUDIO & SUBTITLES             ║ "
    echo " ╚═════════════════════════════════════════════════╝ ${RESET}"

    # Get user input
    get_user_input || return 1

    # Create directory based on movie or TV show
    create_directory || return 1

    # Download streams and combine directly into MKV
    convert_m3u8_to_mkv || return 1

    # Display completion message
    display_completion_message

    # Return to original menu
    show_menu_1
}

get_user_input() {
    prompt "Destination directory? (default: DONE): " destDir "DONE"

    echo ""
    prompt "1080p video URL (required): " videoURL
    prompt "Spanish audio URL (required): " spanishURL
    prompt "English audio URL (optional, enter skip): " englishURL
    prompt "Spanish VTT URL (optional, enter skip): " spanishVTT
    prompt "English VTT URL (optional, enter skip): " englishVTT

    # Normalize optional inputs
    local variable value
    for variable in englishURL spanishVTT englishVTT; do
        value="${!variable}"
        if [[ -z "$value" || "${value,,}" == "skip" ]]; then
            printf -v "$variable" '%s' ""
        fi
    done

    if [[ -z "$videoURL" || -z "$spanishURL" ||
          "${videoURL,,}" == "skip" ||
          "${spanishURL,,}" == "skip" ]]; then
        echo "Video and Spanish audio URLs are required."
        return 1
    fi

    echo ""
    echo " 1) Movie"
    echo " 2) TV Show"
    prompt "Media type? (default: 1): " mediaType "1"

    prompt "Movie/TV show name? (periods between words): " baseName
    [[ -n "$baseName" ]] || return 1

    case "$mediaType" in
        1)
            prompt "Movie release year?: " baseYear
            [[ "$baseYear" =~ ^[0-9]{4}$ ]] || return 1
            ;;
        2)
            prompt "Season number?: " seasonNumber
            prompt "Episode number?: " episodeNumber

            [[ "$seasonNumber" =~ ^[0-9]+$ &&
               "$episodeNumber" =~ ^[0-9]+$ ]] || return 1
            ;;
        *)
            echo "Invalid media type."
            return 1
            ;;
    esac

    prompt "Scene/channel/source? (optional, enter skip): " baseScene ""

    if [[ "${baseScene,,}" == "skip" ]]; then
        baseScene=""
    fi

    baseResolution="1080p"
    destExt="mkv"
}

create_directory() {
    local cleanName season episode sourceName

    cleanName="${baseName// /.}"
    cleanName="${cleanName//\//_}"
    cleanName="${cleanName//\\/_}"

    if [[ "$mediaType" == "1" ]]; then
        dirName="${cleanName//./ } (${baseYear})"
        outputBase="${cleanName}.${baseYear}.1080p.WEBRip"
    else
        season=$((10#$seasonNumber))
        episode=$((10#$episodeNumber))

        printf -v season "%02d" "$season"
        printf -v episode "%02d" "$episode"

        dirName="${cleanName//./ }/Season ${season}"
        outputBase="${cleanName}.S${season}E${episode}.1080p.WEBRip"
    fi

    if [[ -n "$baseScene" ]]; then
        sourceName="${baseScene// /_}"
        sourceName="${sourceName//\//_}"
        sourceName="${sourceName//\\/_}"
        outputBase="${outputBase}-${sourceName}"
    fi

    outputDir="./${destDir}/${dirName}"
    mkdir -p "$outputDir" || return 1

    mkvFile="${outputDir}/${outputBase}.${destExt}"
}

convert_m3u8_to_mkv() {
    echo ""
    echo "Downloading 1080p video, audio and subtitles..."

    local -a inputs=(-i "$videoURL" -i "$spanishURL")
    local -a maps=(-map "0:v:0" -map "1:a:0")
    local -a metadataArgs=(
        -metadata:s:a:0 language=spa
        -metadata:s:a:0 title=Spanish
        -disposition:a:0 default
    )

    local inputIndex=2
    local audioIndex=1
    local subtitleIndex=0

    # Optional English audio
    if [[ -n "$englishURL" ]]; then
        inputs+=(-i "$englishURL")
        maps+=(-map "${inputIndex}:a:0")

        metadataArgs+=(
            "-metadata:s:a:${audioIndex}" "language=eng"
            "-metadata:s:a:${audioIndex}" "title=English"
            "-disposition:a:${audioIndex}" "0"
        )

        ((inputIndex+=1))
        ((audioIndex+=1))
    fi

    # Optional Spanish VTT
    if [[ -n "$spanishVTT" ]]; then
        inputs+=(-i "$spanishVTT")
        maps+=(-map "${inputIndex}:s:0")

        metadataArgs+=(
            "-metadata:s:s:${subtitleIndex}" "language=spa"
            "-metadata:s:s:${subtitleIndex}" "title=Spanish"
        )

        ((inputIndex+=1))
        ((subtitleIndex+=1))
    fi

    # Optional English VTT
    if [[ -n "$englishVTT" ]]; then
        inputs+=(-i "$englishVTT")
        maps+=(-map "${inputIndex}:s:0")

        metadataArgs+=(
            "-metadata:s:s:${subtitleIndex}" "language=eng"
            "-metadata:s:s:${subtitleIndex}" "title=English"
        )
    fi

    if ffmpeg \
        -hide_banner \
        -stats \
        "${inputs[@]}" \
        "${maps[@]}" \
        "${metadataArgs[@]}" \
        -c:v copy \
        -c:a copy \
        -c:s srt \
        -y "$mkvFile"; then

        echo "Conversion completed successfully!"
        return 0
    else
        echo -e "${ERROR}Error converting streams to MKV.${RESET}"
        return 1
    fi
}

display_completion_message() {
    echo ""
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║             DOWNLOAD COMPLETED                 ║ "
    echo " ╚═════════════════════════════════════════════════╝ "

    echo "Resolution: 1080p"
    echo "Audio: Spanish + optional English"
    echo "Subtitles: Optional Spanish / English"
    echo "Container: MKV"
    echo "Output: $mkvFile"

    echo ""
    echo "Final streams:"

    ffprobe \
        -v error \
        -show_entries \
        stream=index,codec_type,codec_name,width,height:stream_tags=language,title \
        -of compact \
        "$mkvFile"

    echo -e "\a"
}
