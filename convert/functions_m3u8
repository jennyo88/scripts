
m3u8() {
    check_ffmpeg || return 1

    echo -e "${MENU_1_COLOR}"
    echo " ╔═════════════════════════════════════════════════╗ "
    echo " ║                M3U8 TO TS TO MKV                ║ "
    echo " ║             MOVIES AND TV SHOWS                 ║ "
    echo " ║        1080P - ENGLISH/SPANISH AUDIO            ║ "
    echo " ╚═════════════════════════════════════════════════╝ ${RESET}"

    # Get user input
    get_user_input || return 1

    # Create directory based on media type
    create_directory || return 1

    # Download M3U8 and convert to TS
    convert_m3u8_to_ts || return 1

    # Convert TS to MKV
    convert_ts_to_mkv || return 1

    # Display completion message
    display_completion_message

    show_menu_1
}

get_user_input() {
    prompt "Destination directory? (default: DONE): " destDir "DONE"
    prompt "Source web-address?: " srcAdd

    echo " 1) Movie"
    echo " 2) TV Show"
    prompt "Media type? (default: 1): " mediaType "1"

    prompt "Movie/TV show name? (periods between words): " baseName

    if [ "$mediaType" = "1" ]; then
        prompt "Movie release year?: " baseYear
    elif [ "$mediaType" = "2" ]; then
        prompt "Season number?: " seasonNumber
        prompt "Episode number?: " episodeNumber
    else
        echo "Invalid media type."
        return 1
    fi

    # Source/release group - no default
    prompt "Scene/channel/source? (optional): " baseScene ""

    prompt "Keep intermediate TS? (y/n | default: n): " keepTS "n"

    baseResolution="1080p"
    destExt="mkv"
}

create_directory() {
    local cleanName season episode

    cleanName="${baseName// /.}"
    cleanName="${cleanName//\//_}"

    if [ "$mediaType" = "1" ]; then
        dirName="${cleanName//./ } (${baseYear})"
        outputBase="${cleanName}.${baseYear}.${baseResolution}.WEBRip"
    else
        printf -v season "%02d" "$((10#$seasonNumber))"
        printf -v episode "%02d" "$((10#$episodeNumber))"

        dirName="${cleanName//./ }/Season ${season}"
        outputBase="${cleanName}.S${season}E${episode}.${baseResolution}.WEBRip"
    fi

    if [ -n "$baseScene" ]; then
        outputBase="${outputBase}-${baseScene}"
    fi

    outputDir="./${destDir}/${dirName}"
    mkdir -p "$outputDir" || return 1

    tsFile="${outputDir}/${outputBase}.ts"
    mkvFile="${outputDir}/${outputBase}.mkv"
}

convert_m3u8_to_ts() {
    echo "Checking available streams..."

    local probeFile streamList
    local videoIndex=""
    local type index language
    local -a audioIndexes=()
    local -a audioLanguages=()
    local -a maps=()
    local -a metadataArgs=()

    probeFile=$(mktemp) || return 1

    if ! ffprobe -v error \
        -show_streams \
        -of json \
        "$srcAdd" > "$probeFile"; then
        rm -f "$probeFile"
        echo "Error reading M3U8."
        return 1
    fi

    streamList=$(python3 - "$probeFile" <<'PY'
import json
import sys

with open(sys.argv[1]) as f:
    streams = json.load(f).get("streams", [])

videos = [
    s for s in streams
    if s.get("codec_type") == "video"
    and s.get("width") == 1920
    and s.get("height") == 1080
]

if not videos:
    sys.exit("No 1080p video available.")

video = max(
    videos,
    key=lambda s: int(s.get("bit_rate") or 0)
)

print("VIDEO", video["index"], "-", sep="\t")

for audio in streams:
    if audio.get("codec_type") != "audio":
        continue

    lang = audio.get("tags", {}).get(
        "language", "und"
    ).lower().replace("_", "-").split("-")[0]

    if lang in ("eng", "en"):
        print("AUDIO", audio["index"], "eng", sep="\t")
    elif lang in ("spa", "es"):
        print("AUDIO", audio["index"], "spa", sep="\t")
PY
) || {
        rm -f "$probeFile"
        echo "Stream selection failed."
        return 1
    }

    rm -f "$probeFile"

    while IFS=$'\t' read -r type index language; do
        case "$type" in
            VIDEO)
                videoIndex="$index"
                ;;
            AUDIO)
                audioIndexes+=("$index")
                audioLanguages+=("$language")
                ;;
        esac
    done <<< "$streamList"

    if [ -z "$videoIndex" ]; then
        echo "1080p video not found."
        return 1
    fi

    if [ ${#audioIndexes[@]} -eq 0 ]; then
        echo "No English or Spanish audio found."
        return 1
    fi

    echo "1080p video selected."
    echo "Audio tracks: ${#audioIndexes[@]}"

    maps=(-map "0:${videoIndex}")

    local i
    for i in "${!audioIndexes[@]}"; do
        maps+=(-map "0:${audioIndexes[$i]}")
        metadataArgs+=(
            "-metadata:s:a:${i}"
            "language=${audioLanguages[$i]}"
        )
        echo " Audio $((i+1)): ${audioLanguages[$i]}"
    done

    # M3U8 to TS without re-encoding
    if ffmpeg \
        -i "$srcAdd" \
        "${maps[@]}" \
        "${metadataArgs[@]}" \
        -c copy \
        -f mpegts \
        -y "$tsFile"; then

        echo "M3U8 to TS conversion complete!"
        return 0
    else
        echo -e "${ERROR}Error converting M3U8 to TS.${RESET}"
        return 1
    fi
}

convert_ts_to_mkv() {
    # TS to MKV without re-encoding
    if ffmpeg \
        -i "$tsFile" \
        -map 0 \
        -c copy \
        -y "$mkvFile"; then

        echo "TS to MKV conversion complete!"

        if [ "$keepTS" != "y" ] && [ "$keepTS" != "Y" ]; then
            rm -f "$tsFile"
        fi

        return 0
    else
        echo -e "${ERROR}Error converting TS to MKV.${RESET}"
        return 1
    fi
}

display_completion_message() {
    echo ""
    echo "Task completed successfully!"
    echo "Resolution: 1080p"
    echo "Audio: English and Spanish only"
    echo "Output: $mkvFile"
    echo -e "\a"
}
