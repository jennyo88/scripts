audiobook_playlist() {
  echo -e "${MENU_1_COLOR}"
  echo " ╔═════════════════════════════════════════════════╗ "
  echo " ║                   Audiobooks                    ║ "
  echo " ║            YT-DLP PLAYLIST TO M4B               ║ "
  echo " ╚═════════════════════════════════════════════════╝ ""${RESET}"

  read -p "Enter the URL of the audiobook playlist: " playlist_url
  read -p "Output audiobook name (without .m4b): " audiobook_name
  read -p "Audio bitrate? [64k]: " bitrate

  bitrate=${bitrate:-64k}

  read -p "Download the whole playlist? [Y/n]: " download_whole_playlist

  if [[ $download_whole_playlist =~ ^[Nn]$ ]]; then
      read -p "Enter item numbers (e.g. 1,2,5-7): " playlist_items
      playlist_items_option=(--playlist-items "$playlist_items")
  else
      playlist_items_option=()
  fi

  safe_name=$(echo "$audiobook_name" | tr ' ' '_' | tr -cd '[:alnum:]_-')

  workdir="${safe_name}_audiobook"
  audiodir="$workdir/audio"
  listfile="$workdir/files.txt"
  outfile="${safe_name}.m4b"

  mkdir -p "$audiodir"

  rm -f "$audiodir"/*
  rm -f "$listfile"
  rm -f "$outfile"

  yt-dlp \
    --yes-playlist \
    --ignore-errors \
    -x \
    --audio-format m4a \
    --audio-quality "$bitrate" \
    --embed-metadata \
    "${playlist_items_option[@]}" \
    -o "$audiodir/%(playlist_index)03d_%(title).200B.%(ext)s" \
    "$playlist_url"

  counter=1

  find "$audiodir" -type f | sort | while read -r oldfile; do

      ext="${oldfile##*.}"

      newname=$(printf "%03d_chapter.%s" "$counter" "$ext")

      mv "$oldfile" "$audiodir/$newname"

      counter=$((counter + 1))

  done

  find "$audiodir" -type f | sort | while read -r f; do
      echo "file '$f'"
  done > "$listfile"

  echo "Creating audiobook..."

  ffmpeg -y \
    -f concat \
    -safe 0 \
    -i "$listfile" \
    -c:a aac \
    -b:a "$bitrate" \
    "$outfile"

  if [[ -f "$outfile" ]]; then
      echo ""
      echo "======================================"
      echo "Audiobook created successfully:"
      echo "$outfile"
      echo "======================================"
  else
      echo ""
      echo "ERROR: Failed to create M4B."
  fi

  pause
  show_menu_1
}
